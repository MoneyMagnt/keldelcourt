# Netlify production does not need these variables when you use Netlify Forms.
# Set them only if you want the local Node preview server to deliver real enquiries.
#
# On Netlify, configure email notifications for the "keldel-court-enquiry" form
# in Project configuration -> Notifications.
#
# Choose one delivery target for the local KelDel Court enquiry API.
# Priority order:
# 1) CRM_WEBHOOK_URL
# 2) RESEND_API_KEY + RESEND_FROM_EMAIL + KELDEL_COURT_TO_EMAIL
# 3) FORMSPREE_ENDPOINT

# Generic CRM / webhook target
CRM_WEBHOOK_URL=

# Resend email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=KelDel Court <leads@example.com>
KELDEL_COURT_TO_EMAIL=sales@example.com

# Formspree direct forwarding
FORMSPREE_ENDPOINT=
